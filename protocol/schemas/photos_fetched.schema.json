{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PhotosFetchedPayload",
  "description": "Phone -> PC: accepted ('transferId' is the file transfer that follows) or why not.",
  "type": "object",
  "required": [
    "requestId",
    "id",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "disabled",
        "no_permission",
        "not_found",
        "busy",
        "invalid",
        "error"
      ]
    },
    "transferId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  }
}
