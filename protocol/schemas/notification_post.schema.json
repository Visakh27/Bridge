{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NotificationPostPayload",
  "description": "Phone -> PC: a notification to show. appId/actions/canDismiss are sent only when the PC advertised notifications.actions; absent fields are omitted, never null.",
  "type": "object",
  "required": [
    "appName",
    "title",
    "text",
    "key"
  ],
  "additionalProperties": false,
  "properties": {
    "appName": {
      "type": "string",
      "maxLength": 101
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 201
    },
    "text": {
      "type": "string",
      "maxLength": 1001
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "appId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._]{1,255}$"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 41
          },
          "reply": {
            "type": "boolean",
            "const": true
          }
        }
      }
    },
    "canDismiss": {
      "type": "boolean"
    }
  }
}
