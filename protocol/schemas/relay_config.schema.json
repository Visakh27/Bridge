{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RelayConfigPayload",
  "description": "PC -> phone, over an authenticated session only: the user's relay (remote access), or enabled=false to stop using one.",
  "type": "object",
  "required": [
    "enabled"
  ],
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*|[0-9A-Fa-f:.]{2,45})$"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    }
  },
  "if": {
    "properties": {
      "enabled": {
        "const": true
      }
    }
  },
  "then": {
    "required": [
      "host",
      "port",
      "key"
    ]
  },
  "else": {
    "not": {
      "anyOf": [
        {
          "required": [
            "host"
          ]
        },
        {
          "required": [
            "port"
          ]
        },
        {
          "required": [
            "key"
          ]
        }
      ]
    }
  }
}
