{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NotificationActionResultPayload",
  "description": "Phone -> PC: outcome of notification.action.",
  "type": "object",
  "required": [
    "requestId",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "requestId": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "gone",
        "refused",
        "invalid",
        "failed"
      ]
    }
  }
}
