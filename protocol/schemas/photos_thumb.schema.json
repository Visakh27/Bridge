{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PhotosThumbPayload",
  "description": "PC -> phone: a small JPEG preview of photo 'id'.",
  "type": "object",
  "required": [
    "requestId",
    "id"
  ],
  "additionalProperties": false,
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9]{1,19}$"
    }
  }
}
