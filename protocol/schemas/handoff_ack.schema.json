{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HandoffAckPayload",
  "description": "The receiver's answer to handoff.open with the same id.",
  "type": "object",
  "required": [
    "id",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "status": {
      "type": "string",
      "enum": [
        "shown",
        "opened",
        "copied",
        "disabled",
        "invalid",
        "busy"
      ]
    }
  }
}
