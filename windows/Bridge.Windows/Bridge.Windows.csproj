<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Bridge.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged by default (needs the Windows App SDK runtime installed); see Package.appxmanifest for MSIX. -->
    <WindowsPackageType>None</WindowsPackageType>
    <Version>0.6.0</Version>
    <ApplicationIcon>Assets\Bridge.ico</ApplicationIcon>
    <!-- MSIX (scripts/package-msix.ps1): sideloaded, one package per platform. -->
    <AppxBundle>Never</AppxBundle>
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
    <AppxPackageDir>$(MSBuildProjectDirectory)\..\AppPackages\</AppxPackageDir>
    <!-- Program.cs provides Main (single instance). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- Every scale/targetsize variant (generated by tools/icons/generate_icons.py) and the .ico for window and tray. -->
    <Content Include="Assets\*.png" />
    <Content Include="Assets\Bridge.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240311000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.3233" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.1.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bridge.Core\Bridge.Core.csproj" />
    <ProjectReference Include="..\Bridge.Network\Bridge.Network.csproj" />
    <ProjectReference Include="..\Bridge.Protocol\Bridge.Protocol.csproj" />
    <ProjectReference Include="..\Bridge.Security\Bridge.Security.csproj" />
  </ItemGroup>
</Project>
