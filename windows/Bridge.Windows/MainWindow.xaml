<Window
    x:Class="Bridge.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Bridge">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Bridge" FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Name="StatusText" Text="Not paired" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Pairing panel: shown while no phone is connected -->
            <StackPanel x:Name="PairingPanel" Grid.Column="0" Spacing="12" HorizontalAlignment="Center">
                <TextBlock Text="Scan with the Bridge Android app" HorizontalAlignment="Center" TextWrapping="Wrap" />
                <Image x:Name="QrImage" Width="220" Height="220" />
                <TextBlock x:Name="QrInfoText" HorizontalAlignment="Center" TextWrapping="Wrap" FontSize="12" Opacity="0.6" />
                <Button Content="Regenerate code" Click="OnRegenerateQrClicked" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Dashboard: device info + drag/drop file target -->
            <StackPanel x:Name="DashboardPanel" Grid.Column="1" Spacing="12" Visibility="Collapsed">
                <TextBlock x:Name="DeviceNameText" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="BatteryText" Opacity="0.8" />
                <Border AllowDrop="True" Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="8" Height="180" Drop="OnFileDrop" DragOver="OnDragOver">
                    <TextBlock Text="Drop files here to send to your phone"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" />
                </Border>
                <ProgressBar x:Name="TransferProgressBar" Minimum="0" Maximum="1" Visibility="Collapsed" />
                <TextBlock x:Name="TransferText" Opacity="0.8" TextWrapping="Wrap" />
                <ToggleSwitch x:Name="ClipboardToggle" Header="Sync clipboard" Toggled="OnClipboardToggled" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Open received files" Click="OnOpenReceivedClicked" />
                    <Button Content="Forget this phone" Click="OnForgetClicked" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" x:Name="FooterText" Opacity="0.5" FontSize="12"
                    Text="Closing this window keeps Bridge running in the system tray." />
    </Grid>
</Window>
